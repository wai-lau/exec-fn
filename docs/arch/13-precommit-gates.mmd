flowchart TD
  start["git commit<br/>STAGED read once"] --> inl["inline template scripts:<br/>node --check (always)"]
  inl --> ruff["ruff<br/>staged .py"]
  ruff --> sl["stylelint<br/>staged web/*.css"]
  sl --> pal["lint-colors.py<br/>css / web js / template staged"]
  pal --> scale["lint-scale.py<br/>web css staged"]
  scale --> sh["shellcheck<br/>staged .sh"]
  sh --> mmd["render-mermaid.py<br/>staged .mmd, SVG re-staged"]
  mmd --> es["ESLint<br/>template scripts + staged web/*.js"]
  es --> sw["lint-swallowed.py<br/>staged web/*.js"]
  sw --> cap["500-line cap +<br/>no multi-line inline script/style"]
  cap --> fx["pytest --setup-plan<br/>tests/ or api/*.py staged"]
  fx --> smoke["page smoke + admin-tier guard<br/>api/*.py or templates staged"]
  smoke --> repo["repo gates by REPO_NAME<br/>spire smoke, cc-sidecar node tests"]
  repo --> tarot["tarot progression (WebKit)<br/>tarot files staged"]
  tarot --> voice["exec-voice (WebKit)<br/>voice layer staged"]
  voice --> note["docs reminder (non-blocking)"]
  note --> claude["CLAUDE.md over 140000 chars?"]
  claude -->|no| ok["commit"]
  claude -->|yes| no["BLOCKED"]
