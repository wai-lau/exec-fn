#!/usr/bin/env bash
set -e

# Repo root — portable across the droplet (/exec-fn) and local dev
# (~/src/exec-fn): derive it instead of hardcoding either path.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# HOST = the exec-fn tree this script came from -- it owns ALL the tooling
# (lints, baselines, configs, .venv, tests/). Three ways in, one answer:
#   - committing in exec-fn itself: HOST = REPO_ROOT;
#   - committing in a sub repo checked out as an exec-fn submodule: its
#     scripts/pre-commit shim execs this file in the superproject;
#   - a sub repo cloned on its own: the shim sparse-pulls ONLY the tooling
#     (scripts/tooling-paths.txt) into the sub repo's gitignored .exec-fn/ and
#     runs this copy from there. ARCHITECTURE.md §1e.
HOST="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# Which repo is committing (spire, noodle, cc-sidecar, exec-fn) -- the gates
# that only one repo needs key off this, and they all live HERE.
REPO_NAME="$(basename -s .git "$(git config --get remote.origin.url 2>/dev/null || echo "$REPO_ROOT")")"
# A sparse tooling copy has no tests/, conftest or .venv: lints only.
FULL_HOST=0
[ -f "$HOST/conftest.py" ] && FULL_HOST=1
# The lints scan what exec-fn serves (lintkit, via api/app_paths.py); a sub
# repo's own files join that scan through this, wherever it is checked out.
if [ "$HOST" != "$REPO_ROOT" ]; then
  export LINT_APP_ROOT="$REPO_ROOT"
fi
# The suites to run: the host's tests/ AND every app's (apps/*/tests) -- from
# the parent or from inside an app alike, since an app's python imports the
# parent's and a parent change can break an app. Fixtures: the root conftest.py.
TEST_DIRS="$HOST/tests/"
for d in "$HOST"/apps/*/tests; do
  [ -d "$d" ] && TEST_DIRS="$TEST_DIRS $d/"
done
# The pytest every gate below uses -- the host's venv, else one on PATH, else
# empty (each pytest gate then skips cleanly, e.g. on a fresh clone).
PYTEST=""
if [ "$FULL_HOST" -eq 0 ]; then
  echo "NOTE: tooling-only copy of exec-fn (.exec-fn/) -- lints run, tests are skipped."
elif [ -x "$HOST/.venv/bin/pytest" ]; then
  PYTEST="$HOST/.venv/bin/pytest"
elif command -v pytest &>/dev/null; then
  PYTEST=pytest
fi
# What the commit stages (added/copied/modified/renamed), read ONCE; every gate
# below filters this list instead of asking git again.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

TEMPLATES="api/templates"
TMPDIR_="$(mktemp -d)"
trap 'rm -rf "$TMPDIR_"' EXIT

fail=0

for f in "$TEMPLATES"/*.html; do
  [ -f "$f" ] || continue
  # Extract content of inline <script> blocks (skip those with src=)
  python3 - "$f" "$TMPDIR_" <<'PYEOF'
import sys, re, os
src = open(sys.argv[1]).read()
outdir = sys.argv[2]
base = os.path.basename(sys.argv[1])
blocks = re.findall(r'<script(?![^>]*\bsrc\b)[^>]*>(.*?)</script>', src, re.DOTALL)
if blocks:
    out = os.path.join(outdir, base + '.js')
    open(out, 'w').write('\n;\n'.join(blocks))
PYEOF
done

for jsfile in "$TMPDIR_"/*.js; do
  [ -f "$jsfile" ] || continue
  name="$(basename "${jsfile%.html.js}").html"
  if ! node --check "$jsfile" 2>&1 | sed "s|$jsfile|$name|g"; then
    fail=1
  fi
done

if [ $fail -ne 0 ]; then
  echo ""
  echo "JS syntax errors found — commit blocked. Fix before committing."
  exit 1
fi

# Python lint
PY_FILES=$(printf '%s\n' "$STAGED" | grep '\.py$' || true)
if [ -n "$PY_FILES" ]; then
  RUFF="$(command -v ruff || echo ~/.local/bin/ruff)"
  if ! "$RUFF" check --config "$HOST/ruff.toml" $PY_FILES 2>&1; then
    echo ""
    echo "Python errors found — commit blocked. Fix before committing."
    exit 1
  fi
fi

# CSS lint — on the STAGED css only, like every other check here.
#
# It used to lint web/*.css wholesale from the working tree, which made it the
# one check in this file that could fail on a file the commit does not touch.
# That is not hypothetical: this tree is production and routinely carries live
# edits, and two Claude sessions share it, so somebody's half-written rule in a
# file you have never opened would block every commit anyone tried to make until
# they happened to finish. A pre-commit hook judges the commit.
CSS_FILES=$(printf '%s\n' "$STAGED" | grep -E '^web/.*\.css$' | grep -vE '^web/vendor/' || true)
if [ -n "$CSS_FILES" ] && command -v stylelint &>/dev/null; then
  if ! echo "$CSS_FILES" | xargs stylelint --config "$HOST/.stylelintrc.json" 2>&1; then
    echo ""
    echo "CSS errors found — commit blocked. Fix before committing."
    exit 1
  fi
fi

# Palette discipline — no new colors or alphas (full-tree scan; runs when any
# css / web-js / template is staged). chrome.css is the only place to add a
# colour; scripts/lint-colors.py's APPROVED_ALPHAS the only place to add an alpha.
PALETTE_FILES=$(printf '%s\n' "$STAGED" | grep -E '^(web/.*\.(css|js)|api/templates/.*\.html)$' | grep -vE '^web/vendor/' || true)
if [ -n "$PALETTE_FILES" ]; then
  if ! python3 "$HOST/scripts/lint-colors.py"; then
    echo ""
    echo "Palette lint failed — commit blocked. No new colors or alphas (see above)."
    exit 1
  fi
fi

# Scale discipline — no new off-scale structural values (full-tree css scan;
# runs when any web css is staged). Every governed property (spacing / radius /
# font-size / weight / line-height / letter-spacing / font-family) must use a
# chrome.css scale token; scripts/scale-codemod.py snaps a page onto them.
SCALE_FILES=$(printf '%s\n' "$STAGED" | grep -E '^web/.*\.css$' | grep -vE '^web/vendor/' || true)
if [ -n "$SCALE_FILES" ]; then
  if ! python3 "$HOST/scripts/lint-scale.py"; then
    echo ""
    echo "Scale lint failed — commit blocked. Snap raw values to chrome.css tokens"
    echo "(python3 scripts/scale-codemod.py shows the diff; see above)."
    exit 1
  fi
fi

# Shell lint
if command -v shellcheck &>/dev/null; then
  SHELL_FILES=$(printf '%s\n' "$STAGED" | grep '\.sh$' || true)
  if [ -n "$SHELL_FILES" ]; then
    if ! shellcheck --severity=warning $SHELL_FILES 2>&1; then
      echo ""
      echo "Shell errors found — commit blocked. Fix before committing."
      exit 1
    fi
  fi
fi

# JS lint (extract inline scripts from templates)
# eslint's config imports @eslint/js + globals from exec-fn's node_modules, and
# finds its config by walking up from the cwd -- so it runs inside exec-fn (a
# submodule included) and is skipped, with a note, in a tooling-only copy.
# Prefer exec-fn's own eslint: a distro /usr/bin/eslint (Ubuntu ships 6.x) predates flat
# config and dies on eslint.config.mjs with "couldn't find a configuration file".
ESLINT="$HOST/node_modules/.bin/eslint"
[ -x "$ESLINT" ] || ESLINT="$(command -v eslint || true)"
if [ ! -d "$HOST/node_modules" ]; then
  echo "NOTE: skipping eslint -- no node_modules beside the tooling ($HOST)."
elif [ -n "$ESLINT" ]; then
  JSTMP="$(mktemp -d "$REPO_ROOT/.eslint-tmp-XXXXXX")"
  trap 'rm -rf "$JSTMP"' EXIT
  python3 - "$TEMPLATES" "$JSTMP" <<'PYEOF'
import sys, re
from pathlib import Path
tmpl_dir, outdir = sys.argv[1], sys.argv[2]
for f in Path(tmpl_dir).glob("*.html"):
    src = f.read_text()
    blocks = re.findall(r'<script(?![^>]*\bsrc\b)[^>]*>(.*?)</script>', src, re.DOTALL)
    if blocks:
        (Path(outdir) / (f.name + '.js')).write_text('\n;\n'.join(blocks))
PYEOF
  if ls "$JSTMP"/*.js &>/dev/null; then
    if ! "$ESLINT" "$JSTMP"/*.js 2>&1 | sed "s|$JSTMP/||g; s|\.html\.js|.html|g"; then
      echo ""
      echo "JS errors found — commit blocked. Fix before committing."
      exit 1
    fi
  fi
  # Lint staged web/*.js too (mainly the per-function size cap). Staged-only =
  # a ratchet: untouched legacy isn't forced, but a file you touch must comply.
  WEB_JS=$(printf '%s\n' "$STAGED" | grep -E '^web/.*\.js$' | grep -vE '^web/vendor/' || true)
  if [ -n "$WEB_JS" ]; then
    if ! "$ESLINT" $WEB_JS 2>&1; then
      echo ""
      echo "JS errors found in web/ — commit blocked. Fix before committing."
      exit 1
    fi
  fi
fi

# ── No code swallowed by a mid-line // comment in staged web/*.js (scripts/lint-swallowed.py; it broke /spire 3x). ──
SWALLOW_FILES=$(printf '%s\n' "$STAGED" | grep -E '^web/[^/]+\.js$' || true)
if [ -n "$SWALLOW_FILES" ]; then
  # shellcheck disable=SC2086
  if ! python3 "$HOST/scripts/lint-swallowed.py" $SWALLOW_FILES; then
    echo "Code after a mid-line // never runs - commit blocked."
    exit 1
  fi
fi

# ── Max-lines (500) on staged .py + .js — no file over the cap. ──
LINE_CAP=500
LINE_CAP_ALLOW=""
cap_fail=0
CAP_FILES=$(printf '%s\n' "$STAGED" | grep -E '\.(py|js)$' | grep -vE '^(node_modules|graphify-out|web/vendor)/' || true)
for f in $CAP_FILES; do
  case " $LINE_CAP_ALLOW " in *" $f "*) continue ;; esac
  n=$(git show ":$f" | wc -l)
  if [ "$n" -gt "$LINE_CAP" ]; then
    echo "$f: $n lines > $LINE_CAP — split it (no .py/.js over $LINE_CAP lines)."
    cap_fail=1
  fi
done

# ── No multi-line inline <script>/<style> in templates (one-liner handlers ok). ──
TPL_FILES=$(printf '%s\n' "$STAGED" | grep -E '^api/templates/.*\.html$' || true)
for f in $TPL_FILES; do
  if ! git show ":$f" | python3 -c 'import sys,re; s=sys.stdin.read(); b=re.findall(r"<style[^>]*>(.*?)</style>",s,re.S)+re.findall(r"<script(?![^>]*\bsrc\b)[^>]*>(.*?)</script>",s,re.S); sys.exit(1 if any(chr(10) in x.strip() for x in b) else 0)'; then
    echo "$f: multi-line inline <script>/<style> — extract to web/ (one-liners ok)."
    cap_fail=1
  fi
done

if [ "$cap_fail" -ne 0 ]; then
  echo ""
  echo "Refactor rules failed — commit blocked. Split long files / extract inline JS+CSS."
  exit 1
fi

# ── Fixture-graph resolution — whole suite, app-independent, ~0.3s. ───────────
# Catches a stale/renamed/deleted fixture reference ANYWHERE in tests/, even
# when the consuming test sits behind a per-feature trigger gate below. A
# fixture lives in conftest and is cross-cutting; the behavioural gates (smoke,
# tarot, voice) are per-feature, so a rename like guest_key->guest_cookie that
# breaks a consumer NOT staged this commit slips through every gate and only
# explodes later when that gate finally fires. `pytest --setup-plan` RESOLVES
# every test's fixture graph without executing fixture/test bodies — no WebKit,
# no live app, no app needed — so a missing fixture fails here regardless of
# which file is staged. Fires whenever any test or api .py is staged (the two
# places a fixture or its consumer changes). Skips cleanly with no pytest venv.
FIXTURES_CHANGED=$(printf '%s\n' "$STAGED" | grep -E '^tests/.*\.py$|^api/.*\.py$' || true)
if [ -n "$FIXTURES_CHANGED" ]; then
  if [ -z "$PYTEST" ]; then
    echo "NOTE: skipping fixture-resolution check — no pytest venv."
  elif ! FX_OUT=$("$PYTEST" $TEST_DIRS --setup-plan -q 2>&1); then
    echo ""
    echo "$FX_OUT" | grep -E "fixture .* not found|ERROR" | head
    echo ""
    echo "Fixture resolution failed — commit blocked. A test references a"
    echo "fixture that no longer exists (renamed/deleted in conftest?). Run:"
    echo "      .venv/bin/pytest tests/ --setup-plan -q"
    exit 1
  fi
fi

# ── Page smoke tests — only when app code changed; hits the live container. ──
# A broken route (wrong status / 500) fails and blocks the commit. A missing
# dev venv (fresh clone) or an unreachable app skips cleanly — the suite's
# conftest pytest.skips when :8080 is down, so a stopped app never blocks.
SRC_CHANGED=$(printf '%s\n' "$STAGED" | grep -E '^api/.*\.py$|^api/templates/.*\.html$' || true)
if [ -n "$SRC_CHANGED" ]; then
  if [ -z "$PYTEST" ]; then
    echo "NOTE: skipping page smoke tests — no pytest. Run:"
    echo "      python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt"
  elif ! SMOKE_BASE_URL="${SMOKE_BASE_URL:-http://localhost:8080}" "$PYTEST" $TEST_DIRS -q -x -m "not browser"; then
    echo ""
    echo "Page smoke tests failed — commit blocked. A page route is broken."
    exit 1
  fi
fi

# ── Repo-specific gates. They live HERE, not in the sub repos (exec-fn owns
# every check); each keys off REPO_NAME and reads the repo's own test files.
if [ "$REPO_NAME" = "spire" ]; then
  # /spire game smoke (node, no browser) — only when the game changed. Loads
  # every /spire script in the template's order into a fake DOM with a
  # RECORDING canvas and drives the real frame loop: boot, 2D / low /
  # 3D-fallback draws, each tower built, a wave fought, the boss sky, Temporal
  # Drive, loss / win / Ascendants. Checks things DRAW, not just that nothing
  # threw (a swallowed else once blanked the board with no error at all).
  SPIRE_CHANGED=$(printf '%s\n' "$STAGED" | grep -E '^web/aspira-.*\.js$|^api/templates/aspira\.html$|^scripts/spire-smoke/' || true)
  if [ -n "$SPIRE_CHANGED" ]; then
    if ! command -v node &>/dev/null; then
      echo "NOTE: skipping /spire smoke — no node."
    elif ! node "$REPO_ROOT/scripts/spire-smoke/smoke.mjs"; then
      echo ""
      echo "/spire smoke failed — commit blocked. Run: node scripts/spire-smoke/smoke.mjs"
      exit 1
    fi
  fi
fi
if [ "$REPO_NAME" = "cc-sidecar" ]; then
  # The sidecar (claude-box): node + shell, not laid out like exec-fn. Syntax on
  # staged .mjs, then EVERY suite (they import the modules) -- each named
  # explicitly: a bare `node --test .` would execute server.mjs (binds the port).
  MJS=$(printf '%s\n' "$STAGED" | grep -E '\.mjs$' || true)
  for f in $MJS; do
    node --check "$f" || { echo "$f: syntax error — commit blocked."; exit 1; }
  done
  if [ -n "$MJS" ]; then
    for t in "$REPO_ROOT"/*.test.mjs; do
      node --test "$t" >/dev/null 2>&1 || { echo "$(basename "$t") failed — commit blocked. Run: node --test $(basename "$t")"; exit 1; }
    done
  fi
fi

# ── Tarot reading-progression (WebKit) — only when the tarot reader changed. ──
# The browser suite (marked `browser`, kept out of the smoke step above) guards
# the invariant that a reading always progresses. Run it when the reader's JS /
# template / api / its own test is staged, so a change there can't ship a
# hang/freeze. Skips cleanly (no pytest venv, no WebKit, or app down) so a fresh
# clone or browser-less CI never blocks — same philosophy as the smoke suite.
# ── browser suites run INSIDE a memory cap ────────────────────────────────
# A WebKit launch wants 200-400MB and this box runs ~1.4GB used with swap
# effectively full, so a browser spike does not fail politely: it invites the
# GLOBAL oom-killer, which picks its victim by badness score rather than by
# culprit and has taken out dbus-daemon and uvicorn's python instead of the
# browser that caused it. Inside a scope the kernel kills only what is in the
# scope, so a blowup fails the commit instead of the site.
#
# Falls back to a bare run wherever systemd-run is unavailable (a fresh clone,
# CI, a container): the cap is a safety net, never a requirement.
run_capped() {
  if command -v systemd-run &>/dev/null && systemd-run --user --scope -q true &>/dev/null; then
    systemd-run --user --scope -q -p MemoryMax=700M "$@"
  else
    "$@"
  fi
}

TAROT_CHANGED=$(printf '%s\n' "$STAGED" | grep -E '^api/tarot/|^api/templates/tarot\.html$|^web/tarot.*\.js$|^web/hosaka-audio\.js$|^tests/test_tarot_progression\.py$' || true)
if [ -n "$TAROT_CHANGED" ]; then
  if [ -z "$PYTEST" ]; then
    echo "NOTE: skipping tarot progression tests — no pytest venv."
  elif ! SMOKE_BASE_URL="${SMOKE_BASE_URL:-http://localhost:8080}" run_capped "$PYTEST" "$HOST/tests/test_tarot_progression.py" -q; then
    echo ""
    echo "Tarot progression tests failed — commit blocked. A reading can hang."
    exit 1
  fi
fi

# ── Exec-voice behaviour (WebKit) — only when the voice layer changed. ────────
# Proves Exec actually speaks its turns in the glados voice (and only the right
# ones) without a real TTS box — the boundary is mocked. Run it when the voice
# scripts / their wiring / this test are staged. Skips cleanly (no pytest venv,
# no WebKit, or app down), same as the tarot suite.
VOICE_CHANGED=$(printf '%s\n' "$STAGED" | grep -E '^web/exec-voice\.js$|^web/exec-voice-listener\.js$|^web/voice-util\.js$|^web/exec-bubble\.js$|^web/hosaka-audio\.js$|^api/pages\.py$|^tests/test_exec_voice_browser\.py$' || true)
if [ -n "$VOICE_CHANGED" ]; then
  if [ -z "$PYTEST" ]; then
    echo "NOTE: skipping exec-voice tests — no pytest venv."
  elif ! SMOKE_BASE_URL="${SMOKE_BASE_URL:-http://localhost:8080}" run_capped "$PYTEST" "$HOST/tests/test_exec_voice_browser.py" -q; then
    echo ""
    echo "Exec-voice tests failed — commit blocked. The voice may be broken."
    exit 1
  fi
fi

# Docs reminder (non-blocking): substantive source changed but docs not staged.
# The hook can't judge necessity — it just nudges so route/pipeline/schema/data/
# naming changes don't ship with stale CLAUDE.md / ARCHITECTURE.md / ARCHAEOLOGY.md.
CHANGED="$STAGED"
CODE_CHANGED=$(echo "$CHANGED" | grep -E '^api/.*\.py$|^api/templates/.*\.html$' || true)
DOCS_CHANGED=$(echo "$CHANGED" | grep -E '^CLAUDE\.md$|^ARCHITECTURE\.md$|^ARCHAEOLOGY\.md$' || true)
if [ -n "$CODE_CHANGED" ] && [ -z "$DOCS_CHANGED" ]; then
  echo ""
  echo "NOTE: source changed but CLAUDE.md / ARCHITECTURE.md / ARCHAEOLOGY.md not staged."
  echo "      If routes, pipelines, schemas, data files, or naming changed, update them."
fi

# CLAUDE.md size cap (blocking). Claude Code stops loading memory files past
# 150k chars; CLAUDE.md hit 211k on 2026-09-27 by accretion — every commit
# appended its measurements to an existing row. It is an index: detail lives in
# ARCHITECTURE.md. Checks the STAGED blob, so an unstaged trim can't mask it.
CLAUDE_MD_MAX=140000
if echo "$CHANGED" | grep -qx 'CLAUDE.md'; then
  CLAUDE_MD_LEN=$(git show :CLAUDE.md | wc -m)
  if [ "$CLAUDE_MD_LEN" -gt "$CLAUDE_MD_MAX" ]; then
    echo ""
    echo "CLAUDE.md is $CLAUDE_MD_LEN chars (cap $CLAUDE_MD_MAX) — commit blocked."
    echo "Move detail into ARCHITECTURE.md and leave a one-line pointer in CLAUDE.md."
    exit 1
  fi
fi

exit 0
