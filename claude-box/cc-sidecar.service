[Unit]
Description=Sandboxed Claude Code sidecar for exec-fn
After=network.target docker.service

[Service]
Type=simple
User=cc-agent
Group=cc-agent
WorkingDirectory=/srv/cc-sandbox
Environment=NODE_ENV=production
Environment=CC_SANDBOX=/srv/cc-sandbox
EnvironmentFile=/etc/cc-sidecar.env
ExecStart=/usr/bin/node /srv/cc-agent/server.mjs
Restart=on-failure
RestartSec=3

# The sandbox is the blast radius, and this is what actually enforces it.
#
# ProtectSystem=strict alone does NOT do that: it makes the filesystem READ-ONLY,
# it does not hide anything. Under it the agent could still `ls /exec-fn`, stat
# docker.sock, and read /exec-fn/.env -- verified live 2026-09-10, which is how
# this was caught. BindPaths= ADDS mounts; it never restricts to them.
#
# So the root is a tmpfs and every path the service needs is bound back in by
# name. That makes it an ALLOWLIST: a directory nobody listed here does not
# exist for this process, including ones that have not been created yet. An
# InaccessiblePaths= denylist would only cover what someone remembered to name.
TemporaryFileSystem=/:ro
BindReadOnlyPaths=/usr /bin /sbin /lib /lib64 /srv/cc-agent
# /etc is bound FILE BY FILE, not wholesale. It used to be the whole directory,
# which was the one place this allowlist went coarse -- and once Bash landed
# (2026-09-13) that mattered: /etc/cron.d/exec-fn-security carries
# SECURITY_OWNER_IP, Wai's home IP, which is precisely the owner-identifying
# data /security is careful never to render. /etc/nginx exposed the topology
# too. Neither is a secret the way a key is, but neither has any business in
# reach of a page that fetches untrusted URLs.
#
# Nothing here is optional: ssl/certs is outbound TLS (api.anthropic.com and
# every WebFetch), nsswitch+hosts+resolv are name resolution, passwd+group are
# user lookup, localtime is the clock. Verified by running probe-tools.mjs after
# the change -- it authenticates to Anthropic, so it exercises DNS and TLS and
# fails loudly if either bind is missing.
BindReadOnlyPaths=/etc/ssl /etc/ca-certificates /etc/ca-certificates.conf
BindReadOnlyPaths=/etc/passwd /etc/group /etc/nsswitch.conf /etc/hosts
BindReadOnlyPaths=/etc/localtime -/etc/resolv.conf
# DNS: /etc/resolv.conf is a symlink into the resolved stub on Ubuntu.
BindReadOnlyPaths=-/run/systemd/resolve
# The only writable paths in the entire namespace.
BindPaths=/srv/cc-sandbox /home/cc-agent

# NO ProtectSystem= here, deliberately. It CONFLICTS with the tmpfs root and
# wins: with ProtectSystem=strict set, the namespace's / came back as the real
# ext4 root mounted read-only (checked in /proc/<pid>/mountinfo) and every path
# above was visible again. Read-only is already covered -- the tmpfs root and
# every bind but the two below are ro.
ProtectHome=tmpfs
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryMax=700M

[Install]
WantedBy=multi-user.target
